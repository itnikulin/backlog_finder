{
  "$schema": "https://app.kilo.ai/config.json",

  // НЕ ГОТОВЫЙ КОНФИГ: сначала замените все replace-* и REQUIRED_*.
  // Merge the completed example into ~/.config/kilo/kilo.jsonc.
  // Global config is trusted, so Kilo can resolve {env:...} without committing secrets.
  "model": "internal-ai/replace-model-id",
  "small_model": "internal-ai/replace-model-id",
  "enabled_providers": ["internal-ai"],

  "provider": {
    "internal-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal AI",
      "options": {
        "baseURL": "https://replace-with-internal-ai.example/v1",
        "apiKey": "{env:INTERNAL_AI_API_KEY}"
      },
      "models": {
        "replace-model-id": {
          "name": "Internal backlog model",
          // Включить только после подтверждения и теста tool calling.
          "tool_call": false,
          // reasoning намеренно не задан: уточните поддержку у AI-команды.
          "limit": {
            // Замените строки ниже реальными положительными ЧИСЛАМИ без кавычек.
            // Эти заглушки намеренно не проходят проверку схемы Kilo.
            "context": "REQUIRED_CONTEXT_TOKENS",
            "output": "REQUIRED_OUTPUT_TOKENS"
          }
        }
      }
    }
  },

  "mcp": {
    "kaiten": {
      "type": "local",
      "command": [
        "node",
        "/ABSOLUTE/PATH/TO/backlog_finder/src/server.mjs"
      ],
      "environment": {
        "KAITEN_BASE_URL": "{env:KAITEN_BASE_URL}",
        "KAITEN_API_TOKEN": "{env:KAITEN_API_TOKEN}",
        "KAITEN_ALLOWED_BOARD_IDS": "{env:KAITEN_ALLOWED_BOARD_IDS}"
      },
      // Включите после настройки модели и списка разрешённых досок.
      "enabled": false,
      "timeout": 30000
    }
  }
}
